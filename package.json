{
  "name": "github-actions-workflow-ts-monorepo",
  "private": true,
  "description": "Generate GitHub Actions workflow files using TypeScript",
  "repository": "https://github.com/emmanuelnk/github-actions-workflow-ts",
  "author": "Emmanuel N Kyeyune",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm exec eslint packages --fix && pnpm exec prettier --config .prettierrc.json --write \"packages/**/*.{ts,tsx}\"",
    "clean": "pnpm -r clean",
    "generate-workflow-files": "node --import tsx packages/cli/dist/bin.js",
    "gwf": "node --import tsx packages/cli/dist/bin.js",
    "generate-workflow-types": "pnpm exec tsx packages/lib/scripts/generateWorkflowTypes.ts && pnpm lint",
    "generate-action-types": "GITHUB_TOKEN=$(gh auth token) pnpm exec tsx packages/actions/scripts/generate.ts && pnpm lint",
    "prepare": "husky install",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.2.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "json-schema-to-typescript": "^15.0.4",
    "lint-staged": "^17.0.4",
    "node-fetch": "^3.3.2",
    "prettier": "3.5.3",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --config .prettierrc.json --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node@<0.16.8": ">=0.16.8",
      "@swc/html@<1.15.47": ">=1.15.47 <2",
      "brace-expansion@<1.1.16": ">=1.1.16 <2",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "browserslist@<4.28.7": ">=4.28.7",
      "fast-uri@<3.1.6": ">=3.1.6 <4",
      "http-proxy-middleware@>=2.0.0 <2.0.10": ">=2.0.10 <3",
      "joi@<17.13.4": ">=17.13.4 <18",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "launch-editor@<2.14.1": ">=2.14.1",
      "linkify-it@<5.0.2": ">=5.0.2 <6",
      "markdown-it@<14.2.0": ">=14.2.0 <15",
      "micromatch@<4.0.8": ">=4.0.8",
      "nanoid@<3.3.17": ">=3.3.17 <4",
      "postcss@<8.5.23": ">=8.5.23",
      "qs@<6.16.0": ">=6.16.0",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "shell-quote@<1.9.0": ">=1.9.0",
      "svgo@>=3.0.0 <3.3.4": ">=3.3.4 <4",
      "uuid@>=8.0.0 <11.1.1": ">=11.1.1 <12",
      "webpack-dev-server@>=5.0.0 <5.2.6": ">=5.2.6 <6",
      "websocket-driver@<0.7.5": ">=0.7.5",
      "ws@>=7.0.0 <7.5.11": ">=7.5.11 <8",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
